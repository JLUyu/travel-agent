DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MEMORY_MODEL=deepseek-chat

# Optional external MCP endpoints. Keep empty to disable the corresponding tool.
AMAP_MCP_URL=
RAILWAY_MCP_URL=
WEB_SEARCH_MCP_URL=

EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.wlai.vip/v1
EMBEDDING_MODEL=text-embedding-3-large

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=false

# Public deployment safety defaults.
PUBLIC_DEPLOYMENT=false
READ_FILE_TOOL_ENABLED=true
SHELL_TOOL_ENABLED=true
PUBLIC_RATE_LIMIT_PER_MINUTE=0
PUBLIC_MAX_PROMPT_CHARS=8000

# Cloud platforms normally inject PORT automatically.
PORT=6006
BACKEND_PORT=6008

# Optional industrial middleware. Keep disabled for local file-only mode.
MYSQL_ENABLED=false
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travel_agent
MYSQL_PASSWORD=travel_agent
MYSQL_DATABASE=travel_agent

REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SECONDS=3600

RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
