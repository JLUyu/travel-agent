# 测试环境示例

# basic 测试不需要真实 LLM/MCP/MySQL/Redis/RabbitMQ。
# LLM 会使用 fake client，外部 MCP 会使用测试替身，本地 MCP 覆盖项目协议链路。
LANGFUSE_TRACING_ENABLED=false

# full 测试会在 basic 基础上额外连接真实 MySQL、Redis、RabbitMQ。
# 建议使用测试库、测试 Redis DB 和测试队列，避免写入开发或生产数据。
MYSQL_ENABLED=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=travel_agent
MYSQL_PASSWORD=travel_agent
MYSQL_DATABASE=travel_agent_test
MYSQL_CHARSET=utf8mb4

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_TTL_SECONDS=3600

RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
